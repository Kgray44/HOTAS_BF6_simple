#include <windows.h>

VS_VERSION_INFO VERSIONINFO @HOTAS_BF6_VERSION_COMMAS@,0
 FILEVERSION @HOTAS_BF6_VERSION_COMMAS@,0
 PRODUCTVERSION @HOTAS_BF6_VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Kgray44"
            VALUE "FileDescription", "HOTAS BF6"
            VALUE "FileVersion", "@HOTAS_BF6_VERSION@"
            VALUE "InternalName", "HOTAS BF6"
            VALUE "OriginalFilename", "HOTAS BF6.exe"
            VALUE "ProductName", "HOTAS BF6"
            VALUE "ProductVersion", "@HOTAS_BF6_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
